<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1300 580" font-family="Arial, Helvetica, sans-serif" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#232F3E"/>
    </marker>
  </defs>
  <rect width="1300" height="580" fill="#ffffff"/>

  <text x="30" y="45" font-size="22" font-weight="bold" fill="#232F3E">Secure Static Website on AWS</text>
  <text x="30" y="68" font-size="13" fill="#5f6b7a">S3 + CloudFront (OAC) + ACM + Route 53, monitored with CloudWatch and SNS</text>

  <!-- ACM -->
  <rect x="520" y="25" width="130" height="75" rx="10" fill="#DD344C"/>
  <text x="585" y="58" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">ACM</text>
  <text x="585" y="78" font-size="11" fill="#fff" text-anchor="middle">SSL/TLS certificate</text>
  <line x1="585" y1="100" x2="585" y2="158" stroke="#232F3E" stroke-width="2" marker-end="url(#arr)"/>
  <text x="598" y="135" font-size="12" fill="#232F3E">HTTPS (cert in us-east-1)</text>

  <!-- User -->
  <rect x="30" y="160" width="120" height="90" rx="10" fill="#f3f4f6" stroke="#9ca3af" stroke-width="2"/>
  <text x="90" y="200" font-size="16" font-weight="bold" fill="#232F3E" text-anchor="middle">User</text>
  <text x="90" y="222" font-size="12" fill="#5f6b7a" text-anchor="middle">Browser</text>

  <!-- Route 53 -->
  <rect x="270" y="160" width="130" height="90" rx="10" fill="#8C4FFF"/>
  <text x="335" y="200" font-size="16" font-weight="bold" fill="#fff" text-anchor="middle">Route 53</text>
  <text x="335" y="222" font-size="12" fill="#fff" text-anchor="middle">DNS (alias records)</text>

  <!-- CloudFront -->
  <rect x="520" y="160" width="130" height="90" rx="10" fill="#8C4FFF"/>
  <text x="585" y="200" font-size="16" font-weight="bold" fill="#fff" text-anchor="middle">CloudFront</text>
  <text x="585" y="222" font-size="12" fill="#fff" text-anchor="middle">CDN + caching</text>

  <!-- S3 website -->
  <rect x="770" y="160" width="130" height="90" rx="10" fill="#7AA116"/>
  <text x="835" y="195" font-size="16" font-weight="bold" fill="#fff" text-anchor="middle">Amazon S3</text>
  <text x="835" y="215" font-size="12" fill="#fff" text-anchor="middle">Private bucket</text>
  <text x="835" y="232" font-size="11" fill="#fff" text-anchor="middle">versioning + SSE</text>

  <!-- Website files -->
  <rect x="1020" y="160" width="250" height="90" rx="10" fill="#f3f4f6" stroke="#9ca3af" stroke-width="2"/>
  <text x="1145" y="200" font-size="16" font-weight="bold" fill="#232F3E" text-anchor="middle">Website files</text>
  <text x="1145" y="222" font-size="13" fill="#5f6b7a" text-anchor="middle">index.html</text>

  <!-- Main flow arrows -->
  <line x1="150" y1="205" x2="268" y2="205" stroke="#232F3E" stroke-width="2" marker-end="url(#arr)"/>
  <text x="209" y="195" font-size="11" fill="#232F3E" text-anchor="middle">kousikvarma.tech</text>
  <line x1="400" y1="205" x2="518" y2="205" stroke="#232F3E" stroke-width="2" marker-end="url(#arr)"/>
  <line x1="650" y1="205" x2="768" y2="205" stroke="#232F3E" stroke-width="2" marker-end="url(#arr)"/>
  <text x="709" y="190" font-size="13" font-weight="bold" fill="#232F3E" text-anchor="middle">OAC</text>
  <text x="709" y="228" font-size="11" fill="#5f6b7a" text-anchor="middle">signed requests</text>
  <line x1="900" y1="205" x2="1018" y2="205" stroke="#232F3E" stroke-width="2" marker-end="url(#arr)"/>

  <!-- Branches from CloudFront -->
  <path d="M570,250 V318 H160 V378" fill="none" stroke="#E7157B" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#arr)"/>
  <text x="365" y="310" font-size="12" fill="#E7157B" text-anchor="middle">Metrics</text>
  <path d="M600,250 V318 H830 V378" fill="none" stroke="#1d70b8" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#arr)"/>
  <text x="715" y="310" font-size="12" fill="#1d70b8" text-anchor="middle">Access logs</text>

  <!-- Monitoring group -->
  <rect x="40" y="380" width="620" height="170" rx="12" fill="#fff7f0" stroke="#E7157B" stroke-width="2" stroke-dasharray="8 5"/>
  <text x="60" y="406" font-size="16" font-weight="bold" fill="#E7157B">Monitoring and alerting</text>
  <rect x="70" y="425" width="170" height="90" rx="10" fill="#E7157B"/>
  <text x="155" y="462" font-size="16" font-weight="bold" fill="#fff" text-anchor="middle">CloudWatch</text>
  <text x="155" y="484" font-size="12" fill="#fff" text-anchor="middle">dashboard + alarms</text>
  <line x1="240" y1="470" x2="458" y2="470" stroke="#232F3E" stroke-width="2" marker-end="url(#arr)"/>
  <text x="350" y="458" font-size="12" fill="#232F3E" text-anchor="middle">4xx / 5xx error-rate alarms</text>
  <text x="350" y="492" font-size="11" fill="#5f6b7a" text-anchor="middle">requests, bytes, error rates</text>
  <rect x="460" y="425" width="170" height="90" rx="10" fill="#E7157B"/>
  <text x="545" y="462" font-size="16" font-weight="bold" fill="#fff" text-anchor="middle">SNS</text>
  <text x="545" y="484" font-size="12" fill="#fff" text-anchor="middle">email notification</text>

  <!-- Logging group -->
  <rect x="710" y="380" width="260" height="170" rx="12" fill="#f0f7ff" stroke="#1d70b8" stroke-width="2" stroke-dasharray="8 5"/>
  <text x="730" y="406" font-size="16" font-weight="bold" fill="#1d70b8">Logging</text>
  <rect x="750" y="425" width="180" height="90" rx="10" fill="#7AA116"/>
  <text x="840" y="462" font-size="16" font-weight="bold" fill="#fff" text-anchor="middle">Amazon S3</text>
  <text x="840" y="484" font-size="12" fill="#fff" text-anchor="middle">CloudFront access logs</text>
</svg>
